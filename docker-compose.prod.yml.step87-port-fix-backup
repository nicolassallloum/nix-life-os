services:
  postgres:
    image: postgres:18
    container_name: nixlifeos-postgres
    restart: unless-stopped
    env_file:
      - .env.docker
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-nixlifeos_db}
      POSTGRES_USER: ${POSTGRES_USER:-nixlifeos_user}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-postgres}
      TZ: ${TZ:-Asia/Beirut}
    ports:
      - "127.0.0.1:5445:5432"
    volumes:
      - nixlifeos_postgres_data:/var/lib/postgresql
      - ./docker/postgres/init.sql:/docker-entrypoint-initdb.d/init.sql:ro
    networks:
      - nixlifeos-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-nixlifeos_user} -d ${POSTGRES_DB:-nixlifeos_db}"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: nixlifeos-backend
    restart: unless-stopped
    env_file:
      - .env.docker
    environment:
      APP_ENV: production
      APP_DEBUG: "false"
      DB_CONNECTION: pgsql
      DB_HOST: postgres
      DB_PORT: 5445
      DB_DATABASE: ${DB_DATABASE:-nixlifeos_db}
      DB_USERNAME: ${DB_USERNAME:-nixlifeos_user}
      DB_PASSWORD: ${DB_PASSWORD:-postgres}
      CACHE_STORE: database
      SESSION_DRIVER: database
      QUEUE_CONNECTION: database
      AI_ENGINE_URL: http://ai-engine:5000
    volumes:
      - ./backend:/var/www/html
      - nixlifeos_backend_storage:/var/www/html/storage
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - nixlifeos-network
    healthcheck:
      test: ["CMD-SHELL", "php artisan about >/dev/null 2>&1 && php artisan migrate:status >/dev/null 2>&1"]
      interval: 30s
      timeout: 15s
      retries: 5
      start_period: 40s

  backend-nginx:
    image: nginx:1.27-alpine
    container_name: nixlifeos-backend-nginx
    restart: unless-stopped
    ports:
      - "127.0.0.1:8000:80"
    volumes:
      - ./backend:/var/www/html:ro
      - ./docker/backend-nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      backend:
        condition: service_healthy
    networks:
      - nixlifeos-network
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost/api/health >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 20s

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    container_name: nixlifeos-frontend
    restart: unless-stopped
    depends_on:
      backend-nginx:
        condition: service_started
    networks:
      - nixlifeos-network
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost/ >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 20s

  ai-engine:
    build:
      context: ./ai-engine
      dockerfile: Dockerfile
    container_name: nixlifeos-ai-engine
    restart: unless-stopped
    env_file:
      - .env.docker
    ports:
      - "127.0.0.1:5000:5000"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - nixlifeos-network
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:5000/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 20s

  nginx:
    image: nginx:1.27-alpine
    container_name: nixlifeos-nginx
    restart: unless-stopped
    ports:
      - "80:80"
    volumes:
      - ./docker/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      frontend:
        condition: service_healthy
      backend-nginx:
        condition: service_healthy
      ai-engine:
        condition: service_healthy
    networks:
      - nixlifeos-network
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost/ >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 20s

volumes:
  nixlifeos_postgres_data:
  nixlifeos_backend_storage:

networks:
  nixlifeos-network:
    driver: bridge
